# Copy this file to .env and replace BOTH values with independent random values.
WEB_PASSWORD=change-me-before-deployment
SECRET_KEY=replace-with-a-random-session-signing-key

# Reading parameters. Restart/recreate the container after changing these.
WEREAD_DURATION=68
READING_INTERVAL_HOURS=12
WEREAD_SPEED=slow
WEREAD_SELECTION=2
WEREAD_SCREENSHOT=true

# true submits run and WeRead user information to the upstream statistics service.
WEREAD_AGREE_TERMS=true

# Configure notifications in the dashboard, or uncomment these placeholders.
# WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_BOT_ID
# WEBHOOK_SECRET=YOUR_BOT_SIGNING_SECRET
# WEREAD_PANEL_URL=https://YOUR_DASHBOARD_ADDRESS
